      ],
      "related_model": "School",
      "service": "SchoolService"
    },
    "StudentController": {
      "file": "app/Modules/Education/Ecoles/Controllers/StudentController.php",
      "actions": [
        "index(school_id?, per_page?, academic_year?, include_archived?) - Liste des élèves",
        "show(id) - Affiche un élève avec user, class_, school"
      ],
      "related_model": "Student",
      "service": "StudentService"
    },
    "TeacherController": {
      "file": "app/Modules/Education/Ecoles/Controllers/TeacherController.php",
      "actions": [
        "index(school_id?, per_page?, academic_year?, include_archived?) - Liste des enseignants",
        "show(id) - Affiche un enseignant avec user, school, classes"
      ],
      "related_model": "Teacher",
      "service": "TeacherService"
    },
    "SchoolClassController": {
      "file": "app/Modules/Education/Ecoles/Controllers/SchoolClassController.php",
      "actions": [
        "index(school_id?, academic_year?, include_archived?) - Liste les classes",
        "show(id) - Affiche une classe avec school, teacher, students"
      ],
      "related_model": "SchoolClass",
      "service": "SchoolClassService"
    },
    "AttendanceController": {
      "file": "app/Modules/Education/Ecoles/Controllers/AttendanceController.php",
      "actions": [
        "index() - Compatibilité GET /attendance",
        "store() - Compatibilité POST /attendance",
