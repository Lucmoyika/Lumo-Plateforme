  "models": {
    "School": {
      "file": "app/Modules/Education/Ecoles/Models/School.php",
      "table": "schools",
      "description": "Représente une école",
      "fillable": [
        "name", "level_types", "address", "city", "province", "phone", 
        "email", "website", "logo", "description", "director_id", "status"
      ],
      "relations": {
        "director": "BelongsTo -> User (director_id)",
        "classes": "HasMany -> SchoolClass",
        "teachers": "HasMany -> Teacher",
        "students": "HasMany -> Student",
        "tasks": "HasMany -> SchoolTask"
      },
      "scopes": [
        "active() - Écoles actives",
        "byLevel(level) - Écoles par niveau (primaire, secondaire, humanites)"
      ],
      "features": [
        "Soft deletes",
        "Media library (pour logo)",
        "level_types stocké en JSON"
      ]
    },

    "Student": {
      "file": "app/Modules/Education/Ecoles/Models/Student.php",
      "table": "students",
      "description": "Représente un élève",
      "fillable": [
        "user_id", "school_id", "class_id", "student_number", "enrollment_date",
        "parent_id", "guardian_name", "guardian_phone", "guardian_email", "status", "archived_at"
      ],
      "relations": {
        "user": "BelongsTo -> User",
        "school": "BelongsTo -> School",
        "class_": "BelongsTo -> SchoolClass (class_id)",
        "parent": "BelongsTo -> User (parent_id)",
        "grades": "HasMany -> Grade",
        "attendances": "HasMany -> Attendance"
      },
      "features": [
        "Lié à un utilisateur User",
        "Peut avoir un parent lié à un autre User",
        "Support d'archive (archived_at)"
      ]
    },

    "Teacher": {
      "file": "app/Modules/Education/Ecoles/Models/Teacher.php",
      "table": "teachers",
      "description": "Représente un enseignant",
      "fillable": [
        "user_id", "school_id", "employee_number", "subjects", "qualification",
        "experience_years", "status", "archived_at"
      ],
      "relations": {
        "user": "BelongsTo -> User",
        "school": "BelongsTo -> School",
        "classes": "HasMany -> SchoolClass (teacher_id)",
        "schedules": "HasMany -> Schedule (teacher_id)"
      },
      "features": [
        "subjects stocké en JSON array",
        "Support d'archive (archived_at)",
        "Qualification et années d'expérience"
      ]
    },

    "SchoolClass": {
      "file": "app/Modules/Education/Ecoles/Models/SchoolClass.php",
      "table": "school_classes",
      "description": "Représente une classe d'école",
      "fillable": [
        "school_id", "name", "level", "academic_year", "teacher_id",
        "max_students", "room", "status", "archived_at"
      ],
      "relations": {
        "school": "BelongsTo -> School",
        "teacher": "BelongsTo -> User (teacher_id)",
        "students": "HasMany -> Student (class_id)",
        "schedules": "HasMany -> Schedule (class_id)",
        "attendances": "HasMany -> Attendance (class_id)",
        "grades": "HasMany -> Grade (class_id)"
      },
      "features": [
        "Liée à une école et un enseignant",
        "Peut archiver l'année académique",
        "Support d'archive (archived_at)"
      ]
    },

    "Grade": {
      "file": "app/Modules/Education/Ecoles/Models/Grade.php",
      "table": "grades",
      "description": "Représente une note d'élève",
      "fillable": [
        "student_id", "subject", "class_id", "academic_year", "term",
        "score", "max_score", "grade_letter", "teacher_id", "exam_type", "notes"
      ],
      "relations": {
        "student": "BelongsTo -> Student",
        "class_": "BelongsTo -> SchoolClass (class_id)",
        "teacher": "BelongsTo -> User (teacher_id)"
      },
      "accessors": [
        "percentage - Calcule le pourcentage (score/max_score * 100)"
      ]
    },

    "Attendance": {
      "file": "app/Modules/Education/Ecoles/Models/Attendance.php",
      "table": "attendances",
      "description": "Enregistrement de présence/absence d'un élève",
      "fillable": [
        "student_id", "class_id", "date", "status", "notes", "recorded_by"
      ],
      "relations": {
        "student": "BelongsTo -> Student",
        "class_": "BelongsTo -> SchoolClass (class_id)",
        "recorder": "BelongsTo -> User (recorded_by)"
      },
      "status_values": ["present", "absent", "late"]
    },

    "Schedule": {
      "file": "app/Modules/Education/Ecoles/Models/Schedule.php",
      "table": "schedules",
      "description": "Horaire/planning de classe",
      "fillable": [
        "class_id", "subject", "teacher_id", "day_of_week", "start_time",
        "end_time", "room", "color", "archived_at"
      ],
      "relations": {
        "class_": "BelongsTo -> SchoolClass (class_id)",
        "teacher": "BelongsTo -> User (teacher_id)"
      },
      "features": [
        "Jour de la semaine (day_of_week)",
        "Heure de début et fin",
        "Code couleur pour affichage calendrier",
        "Support d'archive"
      ]
    },

    "SchoolTask": {
      "file": "app/Modules/Education/Ecoles/Models/SchoolTask.php",
      "table": "school_tasks",
      "description": "Tâche administrative de l'école",
      "fillable": [
        "school_id", "title", "description", "priority", "status",
        "due_date", "assigned_to", "created_by", "completed_at"
      ],
      "relations": {
        "school": "BelongsTo -> School",
        "assignee": "BelongsTo -> User (assigned_to)",
        "creator": "BelongsTo -> User (created_by)"
      },
      "status_values": ["todo", "in_progress", "done", "blocked", "cancelled"],
      "priority_values": ["low", "medium", "high", "urgent"]
    },

    "SchoolPermissionDelegation": {
      "file": "app/Modules/Education/Ecoles/Models/SchoolPermissionDelegation.php",
      "table": "school_permission_delegations",
      "description": "Délégation de permissions pour un membre de l'école",
      "fillable": [
        "school_id", "user_id", "granted_by", "role_name", "permissions",
        "starts_at", "ends_at", "notes", "revoked_at"
      ],
      "relations": {
        "school": "BelongsTo -> School",
        "user": "BelongsTo -> User",
        "grantor": "BelongsTo -> User (granted_by)"
      },
      "delegable_permissions": [
        "school-classes.view", "school-classes.create", "school-classes.update",
        "school-years.view", "school-years.archive",
        "students.view", "students.create", "students.update",
        "teachers.view", "teachers.create", "teachers.update",
        "attendance.view", "attendance.create",
        "grades.view", "grades.create", "grades.update",
        "tasks.view", "tasks.create", "tasks.update"
      ],
      "scopes": [
        "active() - Permissions actuellement actives",
        "forSchool(schoolId) - Permissions pour une école spécifique"
      ]
    }
  },

