  "database_schema": {
    "schools": {
      "columns": [
        "id: integer, primary key",
        "name: string",
        "level_types: json (array)",
        "address: string",
        "city: string",
        "province: string",
        "phone: string",
        "email: string",
        "website: string",
        "logo: string",
        "description: text",
        "director_id: integer, foreign (users.id)",
        "status: enum (active, inactive)",
        "created_at: timestamp",
        "updated_at: timestamp",
        "deleted_at: timestamp (soft delete)"
      ],
      "indexes": ["director_id", "status", "city"],
      "factory": "SchoolFactory"
    },

    "students": {
      "columns": [
        "id: integer, primary key",
        "user_id: integer, foreign (users.id)",
        "school_id: integer, foreign (schools.id)",
        "class_id: integer, foreign (school_classes.id)",
        "student_number: string",
        "enrollment_date: date",
        "parent_id: integer, foreign (users.id, nullable)",
        "guardian_name: string",
        "guardian_phone: string",
        "guardian_email: string",
        "status: enum (active, inactive)",
        "archived_at: timestamp (nullable)",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "indexes": ["user_id", "school_id", "class_id", "parent_id"],
      "factory": "N/A"
    },

    "teachers": {
      "columns": [
        "id: integer, primary key",
        "user_id: integer, foreign (users.id)",
        "school_id: integer, foreign (schools.id)",
        "employee_number: string",
        "subjects: json (array)",
        "qualification: string",
        "experience_years: integer",
        "status: enum (active, inactive)",
        "archived_at: timestamp (nullable)",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "indexes": ["user_id", "school_id"],
      "factory": "N/A"
    },

    "school_classes": {
      "columns": [
        "id: integer, primary key",
        "school_id: integer, foreign (schools.id)",
        "name: string",
        "level: enum (primaire, secondaire, humanites)",
        "academic_year: string (ex: 2024-2025)",
        "teacher_id: integer, foreign (users.id, nullable)",
        "max_students: integer",
        "room: string",
        "status: enum (active, archived)",
        "archived_at: timestamp (nullable)",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "indexes": ["school_id", "academic_year", "teacher_id"],
      "factory": "N/A"
    },

    "grades": {
      "columns": [
        "id: integer, primary key",
        "student_id: integer, foreign (students.id)",
        "subject: string",
        "class_id: integer, foreign (school_classes.id)",
        "academic_year: string",
        "term: string (ex: Q1, Q2, semester1)",
        "score: decimal(5,2)",
        "max_score: decimal(5,2)",
        "grade_letter: string (A, B, C, D, F)",
        "teacher_id: integer, foreign (users.id)",
        "exam_type: enum (homework, quiz, midterm, final, project)",
        "notes: text",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "indexes": ["student_id", "class_id", "term", "academic_year"],
      "factory": "N/A"
    },

    "attendances": {
      "columns": [
        "id: integer, primary key",
        "student_id: integer, foreign (students.id)",
        "class_id: integer, foreign (school_classes.id)",
        "date: date",
        "status: enum (present, absent, late)",
        "notes: text",
        "recorded_by: integer, foreign (users.id)",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "indexes": ["student_id", "class_id", "date"],
      "factory": "N/A"
    },

    "schedules": {
      "columns": [
        "id: integer, primary key",
        "class_id: integer, foreign (school_classes.id)",
        "subject: string",
        "teacher_id: integer, foreign (users.id)",
        "day_of_week: integer (0=Sunday, 6=Saturday)",
        "start_time: time",
        "end_time: time",
        "room: string",
        "color: string (hex code for UI)",
        "archived_at: timestamp (nullable)",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "indexes": ["class_id", "teacher_id"],
      "factory": "N/A"
    },

    "school_tasks": {
      "columns": [
        "id: integer, primary key",
        "school_id: integer, foreign (schools.id)",
        "title: string",
        "description: text",
        "priority: enum (low, medium, high, urgent)",
        "status: enum (todo, in_progress, done, blocked, cancelled)",
        "due_date: date",
        "assigned_to: integer, foreign (users.id, nullable)",
        "created_by: integer, foreign (users.id)",
        "completed_at: timestamp (nullable)",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "indexes": ["school_id", "assigned_to", "status"],
      "factory": "N/A"
    },

    "school_permission_delegations": {
      "columns": [
        "id: integer, primary key",
        "school_id: integer, foreign (schools.id)",
        "user_id: integer, foreign (users.id)",
        "granted_by: integer, foreign (users.id)",
        "role_name: string (ex: 'vice-principal', 'coordinator')",
        "permissions: json (array de permissions)",
        "starts_at: timestamp",
        "ends_at: timestamp",
        "notes: text",
        "revoked_at: timestamp (nullable)",
        "created_at: timestamp",
        "updated_at: timestamp"
      ],
      "indexes": ["school_id", "user_id", "revoked_at"],
      "factory": "N/A"
    }
  },

  "key_features": [
    "Gestion complète des écoles avec directeur et membres",
    "Gestion des classes par année académique avec archivage",
    "Suivi des élèves avec notes et présences",
    "Emploi du temps pour les enseignants et classes",
    "Système de tâches administratives avec priorités",
    "Délégation de permissions avec dates de validité",
    "Contrôle d'accès basé sur les rôles (director, teacher, student)",
    "Support d'archivage pour les données anciennes",
    "Import CSV massif d'élèves",
    "Rapports de présence et bulletins",
    "Statistiques académiques"
  ],

  "relations_diagram": {
    "School": {
      "1": "has many Students",
      "1": "has many Teachers",
      "1": "has many SchoolClasses",
      "1": "has many SchoolTasks",
      "1": "has 1 Director (User)"
    },
    "SchoolClass": {
      "1": "has many Students",
      "1": "has many Schedules",
      "1": "has many Attendances",
