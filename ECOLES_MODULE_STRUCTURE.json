{
  "module": "Education/Ecoles",
  "workspace": "d:\\Lumo-Plateforme",
  "description": "Module complet de gestion des écoles, enseignants, élèves, présences, notes et plannings",
  "lastUpdated": "2026-05-08",
  
  "controllers": {
    "SchoolController": {
      "file": "app/Modules/Education/Ecoles/Controllers/SchoolController.php",
      "actions": [
        "index() - Liste les écoles avec filtres (level, city, status, search)",
